generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  semesters   Semester[]
  assignments Assignment[]

  classSchedules ClassSchedule[]

  notifications    Notification[]
  notificationLogs NotificationDeliveryLog[]
}

model Semester {
  id        String   @id @default(cuid())
  userId    String
  slot      Int
  name      String
  year      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([userId, slot])
  @@index([userId])
}

model Course {
  id         String  @id @default(cuid())
  semesterId String
  code       String?
  name       String
  credit     Int

  mark       Int? // 0–100 (UTHM mark-based)
  gradePoint Float? // optional cache (computed from mark)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([semesterId])
}

enum AssignmentStatus {
  PENDING
  DONE
}

enum AssignmentPriority {
  LOW
  MEDIUM
  HIGH
}

model Assignment {
  id          String             @id @default(cuid())
  userId      String
  courseId    String? // optional for MVP, but recommended
  title       String
  dueDate     DateTime
  status      AssignmentStatus   @default(PENDING)
  priority    AssignmentPriority @default(MEDIUM)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([courseId])
}

model InviteCode {
  id String @id @default(cuid())

  codeId   String @unique // public identifier like A7KQ2F
  codeHash String // sha256(OTP + pepper) (or just sha256(OTP) for MVP)

  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  lockedAt     DateTime?

  @@index([expiresAt])
}

model ClassSchedule {
  id        String   @id @default(cuid())
  userId    String
  title     String
  dayOfWeek Int // 1 = Monday ... 5 = Friday
  startTime String // "08:00"
  endTime   String // "10:00"
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

enum NotificationType {
  ASSIGNMENT_DUE_TOMORROW
  ASSIGNMENT_DUE_TODAY
  CLASS_TOMORROW_SUMMARY
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id                      String           @id @default(cuid())
  userId                  String
  type                    NotificationType
  title                   String
  message                 String
  isRead                  Boolean          @default(false)
  assignmentId            String?
  assignmentTitleSnapshot String?
  courseNameSnapshot      String?
  createdAt               DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model NotificationDeliveryLog {
  id               String              @id @default(cuid())
  userId           String
  type             NotificationType
  channel          NotificationChannel
  notificationDate DateTime
  assignmentId     String?
  createdAt        DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel, notificationDate, assignmentId])
  @@index([createdAt])
  @@index([userId, notificationDate])
}
