Copy this file to `.env` and fill in the required values before running the project.

# =====================================
# Database
# =====================================

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/studexcenter"

# =====================================
# Authentication
# =====================================

SESSION_SECRET=replace_with_secure_random_string

# =====================================
# Internal Cron Security
# =====================================

INTERNAL_CRON_SECRET=replace_with_secure_random_string

# =====================================
# Gmail API (Assignment Reminder Emails)
# =====================================

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_REFRESH_TOKEN=your-refresh-token
GMAIL_SENDER_EMAIL=your-email@gmail.com
